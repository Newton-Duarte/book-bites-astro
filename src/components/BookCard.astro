---
import type { Book } from "../content/books/schema";

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<div class="book-card">
  <p class="book-title">
    {book.title}, {book.rating}/10
  </p>
  <p class="book-author">by {book.author}</p>
  <p class="book-summary">{book.summary}</p>
  <a href="">Read Review</a>
</div>

<style>
  .book-card {
    background-color: #f9f6fc;
    padding: 16px 20px;
    margin: 20px auto;
    box-shadow: 8px 8px 0 #ebe5f2;
  }
  .book-title {
    font-size: 1.4em;
    font-weight: bold;
    margin: 0;
  }
  .book-author {
    margin-top: 0;
  }
  .book-summary {
    font-size: 1em;
  }
</style>
